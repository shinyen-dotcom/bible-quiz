  { id: "tf6", type: "tf", title: "耶稣允许那个得洁净的人上船与祂一同离开格拉森去传道。", ans: "F", desc: "错。可 5:19 耶稣不许，吩咐他回家到亲属那里作见证。" },
  { id: "tf7", type: "tf", title: "管会堂的睚鲁来求耶稣时，带着极为恭敬的态度俯伏在耶稣脚前。", ans: "T", desc: "对。可 5:22 见耶稣就俯伏在他脚前。" },
  { id: "tf8", type: "tf", title: "患血漏的女人相信只要摸到耶稣的衣裳就必痊愈。", ans: "T", desc: "对。可 5:28 她说我只摸他的衣裳就必痊愈。" },
  { id: "tf9", type: "tf", title: "患血漏的妇人摸了衣裳后，过了好几天病才渐渐好转。", ans: "F", desc: "错。可 5:29 她的血漏源头立刻干了。" },
  { id: "tf10", type: "tf", title: "面对拥挤的人群，彼得等门徒对耶稣追问“谁摸我”感到难以理解。", ans: "T", desc: "对。可 5:31 门徒说你看众人拥挤你还说谁摸我吗。" },
  { id: "tf11", type: "tf", title: "当管会堂家里传来女孩死讯时，耶稣对睚鲁说：“不要怕，只要信！”", ans: "T", desc: "对。可 5:36 经文完全吻合。" },
  { id: "tf12", type: "tf", title: "在睚鲁家里，那些哭泣哀号的人听见耶稣说孩子是睡着了，就感动得痛哭。", ans: "F", desc: "错。可 5:40 众人听见就嗤笑耶稣。" },
  { id: "tf13", type: "tf", title: "「大利大古米」翻译出来的意思是：「平平安安地回去吧！」", ans: "F", desc: "错。可 5:41 翻出来是说：「闺女，我吩咐你起来！」" },
  { id: "tf14", type: "tf", title: "女孩复活后，耶稣切切嘱咐不要叫人知道，并吩咐给她东西吃。", ans: "T", desc: "对。可 5:43 经文完全吻合。" }
];

// 核心功能：根据本次抽中的填空题，动态精准过滤出最相关的 Answer Pool
const DISTRACTOR_POOL_CH5 = ["迦百农", "二百", "衣服", "睡着了", "二万", "彼得", "按手", "撒但", "十二岁", "十倍"];

function generateDynamicAnswerPool(selectedQuestions) {
  const answerSet = new Set();
  selectedQuestions.forEach(q => {
    if (q.type === "fill" && q.blanks) {
      q.blanks.forEach(b => {
        const primaryAns = b.ans.split("|")[0].trim();
        if (primaryAns) answerSet.add(primaryAns);
      });
    }
  });

  const shuffledDistractors = shuffleArray(DISTRACTOR_POOL_CH5);
  for (let i = 0; i < shuffledDistractors.length && answerSet.size < 22; i++) {
    answerSet.add(shuffledDistractors[i]);
  }

  return shuffleArray(Array.from(answerSet));
}

let activeQuestionSet = []; 
let activeDynamicWordPool = []; 
let activeBlankId = null;
const STORAGE_KEY = "mark_ch5_quiz_pool_v1";

function shuffleArray(arr) {
  const array = [...arr];
  for (let i = array.length - 1; i > 0; i--) {
    const j = Math.floor(Math.random() * (i + 1));
    [array[i], array[j]] = [array[j], array[i]];
  }
  return array;
}

function initQuiz(forceRegenerate = false) {
  const savedData = localStorage.getItem(STORAGE_KEY);
  if (!forceRegenerate && savedData) {
    try {
      const parsed = JSON.parse(savedData);
      activeQuestionSet = parsed.questions || [];
      activeDynamicWordPool = parsed.wordPool || [];
      renderQuizUI();
      restoreSavedAnswers(parsed.answers || {});
      return;
    } catch(e) { console.error(e); }
  }

  // 严格从 50 题题库中洗牌抽取 50 题（全量考卷）
  const shuffledPool = shuffleArray(MASTER_QUESTION_POOL);
  const selected = shuffledPool.slice(0, 50);

  // 按题型排序：填空 -> 选择/排序 -> 是非
  const typeOrder = { "fill": 1, "radio": 2, "tf": 3 };
  activeQuestionSet = selected.sort((a, b) => typeOrder[a.type] - typeOrder[b.type]);

  // 动态匹配专属词库
  activeDynamicWordPool = generateDynamicAnswerPool(activeQuestionSet);

  saveQuizState({});
  renderQuizUI();
}

function regenerateQuiz() {
  if (confirm("确定要重新随机抽取 50 题并刷新专属词库吗？")) {
    localStorage.removeItem(STORAGE_KEY);
    initQuiz(true);
  }
}

function renderQuizUI() {
  const container = document.getElementById("quiz-sections-container");
  container.innerHTML = "";

  const groups = {
    "fill": { title: "第一部分：填空题", desc: "请参考下方专为此卷生成的词库填入空格（点击词汇填入，点击输入框反选清除）：", list: [] },
    "radio": { title: "第二部分：单选、多选与排序题", desc: "请点按正确选项：", list: [] },
    "tf": { title: "第三部分：是非判断题", desc: "判断下列说法是否正确（√ 正确，× 错误）：", list: [] }
  };

  activeQuestionSet.forEach(q => {
    if (groups[q.type]) groups[q.type].list.push(q);
  });

  let globalQuestionCounter = 1;

  ["fill", "radio", "tf"].forEach(typeKey => {
    const grp = groups[typeKey];
    if (grp.list.length === 0) return;

    const startNum = globalQuestionCounter;
    const endNum = globalQuestionCounter + grp.list.length - 1;

    const secHeader = document.createElement("div");
    secHeader.className = "type-section-header";
    secHeader.innerHTML = `
      <h3 class="type-section-title">${grp.title}（第 ${startNum} - ${endNum} 题）</h3>
      <p class="type-section-desc">${grp.desc}</p>
    `;
    container.appendChild(secHeader);

    // 专属置顶 Answer Pool
    if (typeKey === "fill") {
      const bankCard = document.createElement("div");
      bankCard.className = "word-bank-box";
      bankCard.innerHTML = `
        <div class="word-bank-title">
          <span>💡 填空题专属匹配词库 (Answer Pool)：点击词汇填入，点击输入框反选清除</span>
          <button style="border:none; background:#dbeafe; color:var(--accent); border-radius:4px; padding:3px 8px; font-size:12px; cursor:pointer;" onclick="renderWordBank()">🔀 打乱词库</button>
        </div>
        <div class="word-chips" id="word-chips-container"></div>
      `;
      container.appendChild(bankCard);
    }

    grp.list.forEach(q => {
      const item = document.createElement("div");
      item.className = "q-item";
      item.id = `card-${q.id}`;

      if (q.type === "fill") {
        let fillText = q.title;
        q.blanks.forEach(b => {
          const inputHtml = `<input type="text" class="blank-input" id="${b.id}" data-ans="${b.ans}" readonly onclick="handleBlankClick(this)">`;
          fillText = fillText.replace("_____", inputHtml);
        });
        item.innerHTML = `
          <div style="font-size:15px; line-height:2.4; word-break:break-word;">
            <span style="color:var(--accent); font-weight:bold; margin-right:4px;">${globalQuestionCounter}.</span>${fillText}
          </div>
          <div class="feedback" id="fb-${q.id}"></div>
        `;
      } else if (q.type === "radio") {
        const isMulti = Array.isArray(q.ans);
        let optsHtml = `<div class="opt-group">`;
        q.opts.forEach(opt => {
          const inputType = isMulti ? "checkbox" : "radio";
          optsHtml += `<label class="opt-label"><input type="${inputType}" name="${q.id}" value="${opt.v}" onchange="onUserAnswerChange()"> ${opt.t}</label>`;
        });
        optsHtml += `</div>`;
        item.innerHTML = `
          <div class="q-title"><span style="color:var(--accent); font-weight:bold;">${globalQuestionCounter}.</span> ${q.title}</div>
          ${optsHtml}
          <div class="feedback" id="fb-${q.id}"></div>
        `;
      } else if (q.type === "tf") {
        item.innerHTML = `
          <div class="q-title"><span style="color:var(--accent); font-weight:bold;">${globalQuestionCounter}.</span> ${q.title}</div>
          <div class="opt-group" style="flex-direction:row; max-width:280px;">
            <label class="opt-label" style="flex:1;"><input type="radio" name="${q.id}" value="T" onchange="onUserAnswerChange()"> √ 正确</label>
            <label class="opt-label" style="flex:1;"><input type="radio" name="${q.id}" value="F" onchange="onUserAnswerChange()"> × 错误</label>
          </div>
          <div class="feedback" id="fb-${q.id}"></div>
        `;
      }

      container.appendChild(item);
      globalQuestionCounter++;
    });
  });

  if (document.getElementById("word-chips-container")) {
    renderWordBank();
  }

  calculateAndUpdateTotals(0);
}

function renderWordBank() {
  const container = document.getElementById("word-chips-container");
  if (!container) return;
  container.innerHTML = "";
  const shuffledWords = shuffleArray(activeDynamicWordPool);
  shuffledWords.forEach(word => {
    const chip = document.createElement("span");
    chip.className = "word-chip";
    chip.innerText = word;
    chip.onclick = () => insertWordToBlank(word);
    container.appendChild(chip);
  });
}

function handleBlankClick(inputEl) {
  if (inputEl.value) {
    inputEl.value = "";
    inputEl.classList.remove("has-val");
    onUserAnswerChange();
  }
  document.querySelectorAll(".blank-input").forEach(b => b.classList.remove("active-blank"));
  inputEl.classList.add("active-blank");
  activeBlankId = inputEl.id;
}

function insertWordToBlank(word) {
  let target = null;
  if (activeBlankId) {
    target = document.getElementById(activeBlankId);
  }
  if (!target || target.value) {
    const blanks = Array.from(document.querySelectorAll(".blank-input"));
    target = blanks.find(b => !b.value);
  }

  if (target) {
    target.value = word;
    target.classList.add("has-val");
    onUserAnswerChange();

    const blanks = Array.from(document.querySelectorAll(".blank-input"));
    const nextEmpty = blanks.find(b => !b.value);
    blanks.forEach(b => b.classList.remove("active-blank"));
    if (nextEmpty) {
      nextEmpty.classList.add("active-blank");
      activeBlankId = nextEmpty.id;
    } else {
      activeBlankId = target.id;
      target.classList.add("active-blank");
    }
  }
}

function onUserAnswerChange() {
  saveQuizState(getUserAnswers());
}

function getUserAnswers() {
  const answers = {};
  document.querySelectorAll("#quiz-sections-container input").forEach(el => {
    if (el.type === "radio" || el.type === "checkbox") {
      if (el.checked) {
        if (!answers[el.name]) {
          answers[el.name] = el.type === "checkbox" ? [el.value] : el.value;
        } else if (Array.isArray(answers[el.name])) {
          answers[el.name].push(el.value);
        }
      }
    } else if (el.type === "text") {
      if (el.value) answers[el.id] = el.value;
    }
  });
  return answers;
}

function saveQuizState(answers) {
  const data = {
    questions: activeQuestionSet,
    wordPool: activeDynamicWordPool,
    answers: answers || getUserAnswers()
  };
  localStorage.setItem(STORAGE_KEY, JSON.stringify(data));
  document.getElementById("save-status").innerText = "💾 进度已自动保存 (" + new Date().toLocaleTimeString([], {hour:'2-digit', minute:'2-digit'}) + ")";
}

function restoreSavedAnswers(answers) {
  Object.keys(answers).forEach(key => {
    const val = answers[key];
    const textEl = document.getElementById(key);
    if (textEl && textEl.type === "text") {
      textEl.value = val;
      textEl.classList.add("has-val");
    } else if (Array.isArray(val)) {
      val.forEach(v => {
        const chk = document.querySelector(`input[name="${key}"][value="${v}"]`);
        if (chk) chk.checked = true;
      });
    } else {
      const rad = document.querySelector(`input[name="${key}"][value="${val}"]`);
      if (rad) rad.checked = true;
    }
  });
}

function gradeQuiz() {
  let score = 0;
  const total = activeQuestionSet.length;

  activeQuestionSet.forEach(q => {
    const fb = document.getElementById(`fb-${q.id}`);

    if (q.type === "radio" || q.type === "tf") {
      let isCorrect = false;
      if (Array.isArray(q.ans)) {
        const checked = Array.from(document.querySelectorAll(`input[name="${q.id}"]:checked`)).map(e => e.value);
        if (checked.length === q.ans.length && q.ans.every(v => checked.includes(v))) {
          isCorrect = true;
        }
      } else {
        const checked = document.querySelector(`input[name="${q.id}"]:checked`);
        if (checked && checked.value === q.ans) {
          isCorrect = true;
        }
      }
      
      if (isCorrect) {
        score++;
        fb.className = "feedback is-correct";
        fb.innerHTML = `正确！解析：${q.desc}`;
      } else {
        fb.className = "feedback is-wrong";
        const ansTxt = Array.isArray(q.ans) ? q.ans.join(", ").toUpperCase() : (q.ans === "T" ? "√ 正确" : (q.ans === "F" ? "× 错误" : q.ans.toUpperCase()));
        fb.innerHTML = `标准答案：【${ansTxt}】。解析：${q.desc}`;
      }
    } else if (q.type === "fill") {
      let fillOk = true;
      q.blanks.forEach(b => {
        const el = document.getElementById(b.id);
        const userVal = (el ? el.value.trim() : "");
        const validAns = b.ans.split("|").map(s => s.trim());
        if (validAns.includes(userVal)) {
          el.style.borderBottomColor = "#16a34a"; el.style.background = "#dcfce7";
        } else {
          fillOk = false;
          if (el) { el.style.borderBottomColor = "#dc2626"; el.style.background = "#fee2e2"; }
        }
      });

      if (fillOk) {
        score++;
        fb.className = "feedback is-correct";
        fb.innerHTML = `正确！出处：${q.desc}`;
      } else {
        fb.className = "feedback is-wrong";
        const correctAns = q.blanks.map(b => b.ans.split("|")[0]).join(" / ");
        fb.innerHTML = `正确答案：【${correctAns}】。出处：${q.desc}`;
      }
    }
  });

  calculateAndUpdateTotals(score);
  window.scrollTo({ top: 0, behavior: "smooth" });
}

function calculateAndUpdateTotals(score) {
  const total = activeQuestionSet.length;
  document.getElementById("total-score").innerText = `${score} / ${total}`;
  document.getElementById("accuracy-rate").innerText = total > 0 ? `${Math.round((score / total) * 100)}%` : `0%`;
}

function switchTab(tabId) {
  document.querySelectorAll(".nav-tabs .tab-btn").forEach(btn => btn.classList.remove("active"));
  document.querySelectorAll(".tab-content").forEach(c => c.classList.remove("active"));
  
  if (event && event.target) event.target.classList.add("active");
  const targetTab = document.getElementById("tab-" + tabId);
  if (targetTab) targetTab.classList.add("active");
}

window.addEventListener("DOMContentLoaded", () => {
  initQuiz();
});
</script>

